rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Menor de idade = ainda não completou 18 anos na data de hoje (request.time).
    // dataNascimento vem sempre no formato "AAAA-MM-DD" (input type=date do formulário).
    function alunoMenorDeIdade(dataNascimento) {
      let partes = dataNascimento.split('-');
      let dataAniversario18 = timestamp.date(int(partes[0]) + 18, int(partes[1]), int(partes[2]));
      return request.time < dataAniversario18;
    }

    // Valida tipo/tamanho dos campos de cadastro (formulário "DADOS DO ALUNO").
    // documentoAluno e telefoneAluno são opcionais no formulário — o campo sempre
    // existe no documento (string vazia se não preenchido). Os dados do responsável
    // (nome, documento, telefone) só são obrigatórios se o aluno for menor de idade;
    // o endereço do responsável continua obrigatório em qualquer caso.
    function dadosAlunoValidos(dados) {
      return dados.nomeCompleto is string && dados.nomeCompleto.size() > 0 && dados.nomeCompleto.size() < 100
        && dados.dataNascimento is string && dados.dataNascimento.size() > 0
        && dados.documentoAluno is string && dados.documentoAluno.size() < 20
        && dados.telefoneAluno is string && dados.telefoneAluno.size() < 30
        && dados.faixa in ['Branca', 'Cinza', 'Amarela', 'Laranja', 'Verde', 'Azul', 'Roxa', 'Marrom', 'Preta']
        && dados.nomeResponsavel is string && dados.nomeResponsavel.size() < 100
        && dados.documentoResponsavel is string && dados.documentoResponsavel.size() < 20
        && dados.enderecoResponsavel is string && dados.enderecoResponsavel.size() > 0 && dados.enderecoResponsavel.size() < 150
        && dados.telefoneResponsavel is string && dados.telefoneResponsavel.size() < 30
        && dados.email is string && dados.email.size() < 100
        && (!alunoMenorDeIdade(dados.dataNascimento) || (
          dados.nomeResponsavel.size() > 0
          && dados.documentoResponsavel.size() > 0
          && dados.telefoneResponsavel.size() > 0
        ));
    }

    match /alunos/{alunoId} {
      allow create: if isSignedIn() && request.auth.uid == alunoId
        && dadosAlunoValidos(request.resource.data);

      allow read: if isSignedIn() && (request.auth.uid == alunoId || isAdmin());

      allow update: if isSignedIn() && (request.auth.uid == alunoId || isAdmin())
        && dadosAlunoValidos(request.resource.data);

      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // só é possível adicionar pelo Console do Firebase
    }

    // ===== Rifa (compra pública, sem cadastro/login) =====
    //
    // Cada número (1 a 200) só vira documento quando é reservado — a ausência do
    // documento É o estado "disponível". Isso dá reserva atômica "de graça": o
    // visitante reserva N números com um único batch write contendo um `create`
    // por número; se qualquer um deles já existir (outra pessoa reservou antes),
    // a rule de `create` não bate (documento já existe → cai em `update`, que é
    // bloqueado pra clientes) e o Firestore desfaz o batch inteiro. Só o Worker
    // (Cloudflare, autenticado como service account — não passa pelas rules)
    // marca como pago ou libera reservas expiradas.
    function numeroRifaValido(numero, dados) {
      return dados.numero is int && dados.numero == int(numero) && dados.numero >= 1 && dados.numero <= 200
        && dados.status == 'reservado'
        && dados.pedidoId is string && dados.pedidoId.size() > 0
        && dados.reservadoEm == request.time;
    }

    match /rifaNumeros/{numero} {
      allow read: if true; // cartela pública
      allow create: if numeroRifaValido(numero, request.resource.data);
      allow update, delete: if false;
    }

    // Um pedido cobre 1+ números pagos numa única cobrança Pix. Criado pelo
    // visitante (sem login); os campos do Pix (QR code etc.) só existem depois
    // que o Worker consulta o Mercado Pago — por isso `create` exige que eles
    // ainda não estejam presentes.
    function pedidoRifaValido(dados) {
      return dados.numeros is list && dados.numeros.size() > 0 && dados.numeros.size() <= 200
        && dados.nomeComprador is string && dados.nomeComprador.size() > 0 && dados.nomeComprador.size() < 100
        && dados.telefoneComprador is string && dados.telefoneComprador.size() > 0 && dados.telefoneComprador.size() < 30
        && dados.valorTotal is number && dados.valorTotal == dados.numeros.size() * 6
        && dados.status == 'pendente'
        && dados.criadoEm == request.time
        && dados.keys().hasOnly(['numeros', 'nomeComprador', 'telefoneComprador', 'valorTotal', 'status', 'criadoEm']);
    }

    match /rifaPedidos/{pedidoId} {
      // Documento só é acessível por get() (link direto, ID sabido pelo comprador
      // logo após criar) — nunca por list(), então ninguém consegue varrer nomes
      // e telefones de outros compradores.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if pedidoRifaValido(request.resource.data);
      allow update, delete: if false;
    }

    // ===== Doação livre (fora da rifa, sem cadastro/login) =====
    function doacaoValida(dados) {
      return dados.valor is number && dados.valor >= 1 && dados.valor <= 50000
        && dados.nomeDoador is string && dados.nomeDoador.size() < 100
        && dados.status == 'pendente'
        && dados.criadoEm == request.time
        && dados.keys().hasOnly(['valor', 'nomeDoador', 'status', 'criadoEm']);
    }

    match /doacoes/{doacaoId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if doacaoValida(request.resource.data);
      allow update, delete: if false;
    }
  }
}
